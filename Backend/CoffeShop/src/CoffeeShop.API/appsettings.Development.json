{
  "UseInMemoryDatabase": true,
  "JwtSettings": {
    "SecretKey": "your-256-bit-secret-key-for-jwt-signing!!",
    "Issuer": "CoffeeShopAPI",
    "Audience": "CoffeeShopClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "AdminSetup": {
    "DefaultAdminEmail": "admin@coffeeshop.com",
    "DefaultAdminPassword": "Admin@123",
    "SetupSecretKey": "dev-admin-setup-secret-change-me",
    "ResetDefaultAdminPasswordOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  }
}
